(allow chdroidd toolbox_exec (file (execute execute_no_trans map open read)))
(allow chdroidd ueventd (file (read)))
(allow chdroidd unlabeled (blk_file (unlink)))
(allow chdroidd unlabeled (dir (add_name create getattr mounton open read remove_name rmdir search setattr watch write)))
(allow chdroidd unlabeled (file (append create execute execute_no_trans getattr ioctl link lock map mounton open read rename setattr unlink write)))
(allow chdroidd unlabeled (filesystem (getattr mount)))
(allow chdroidd unlabeled (lnk_file (getattr read rename)))
(allow chdroidd vendor_init (file (read)))
(allow chdroidd vendor_toolbox_exec (file (execute_no_trans)))
(allow chdroidd vndservicemanager (file (read)))
(allow chdroidd vold (file (read)))
