; Minimal rules to suppress log spam in dmesg
; It is impossible to make chdroid an enforcing domain. Fix one denial, and ten more appear, and it continues until the world ends
; This is the best we can do, which is suppressing the visible denials that happen during permissive mode

; chdroidd
(allow chdroidd activity_service (service_manager (find)))
(allow chdroidd app_data_file (dir (add_name create getattr mounton open read remove_name search setattr write)))
(allow chdroidd app_data_file (file (append create getattr ioctl open read relabelfrom setattr write)))
(allow chdroidd app_data_file (lnk_file (unlink)))
(allow chdroidd app_data_file (sock_file (write)))
(allow chdroidd binder_device (chr_file (getattr ioctl map open read write)))
(allow chdroidd bpfloader (bpf (prog_run)))
(allow chdroidd cgroup (dir (add_name create read rmdir setattr write)))
(allow chdroidd cgroup (file (ioctl open read write)))
(allow chdroidd cgroup_v2 (dir (add_name create open read remove_name rmdir search setattr write)))
(allow chdroidd cgroup_v2 (file (getattr ioctl open read watch write)))
(allow chdroidd cgroup_v2 (filesystem (remount)))
(allow chdroidd configfs (filesystem (remount)))
(allow chdroidd debugfs (filesystem (remount)))
(allow chdroidd debugfs_tracing_debug (filesystem (remount)))
(allow chdroidd device (chr_file (getattr ioctl open read write)))
(allow chdroidd device (dir (add_name write)))
(allow chdroidd device_config_service (service_manager (find)))
(allow chdroidd deviceidle_service (service_manager (find)))
(allow chdroidd devpts (chr_file (getattr ioctl lock open read setattr write)))
(allow chdroidd devpts (filesystem (mount)))
(allow chdroidd dm_device (blk_file (getattr)))
(allow chdroidd chdroidd (capability (net_admin net_raw sys_admin sys_ptrace sys_resource)))
(allow chdroidd chdroidd (fifo_file (ioctl)))
(allow chdroidd chdroidd (file (ioctl)))
(allow chdroidd chdroidd (netlink_route_socket (bind create getattr nlmsg_read nlmsg_write read setopt write)))
(allow chdroidd chdroidd (packet_socket (read)))
(allow chdroidd chdroidd (rawip_socket (create getopt setopt write)))
(allow chdroidd chdroidd (udp_socket (create ioctl)))
(allow chdroidd chdroidd (unix_dgram_socket (ioctl)))
(allow chdroidd chdroidd_exec (file (entrypoint execute_no_trans open read)))
(allow chdroidd chdroidd_exec (lnk_file (read)))
(allow chdroidd fs_bpf (dir (search)))
(allow chdroidd fs_bpf_netd_shared (dir (search)))
(allow chdroidd fs_bpf_netd_shared (file (read)))
(allow chdroidd fsck_exec (file (execute execute_no_trans map open read)))
(allow chdroidd fuse (dir (read)))
(allow chdroidd fuse (filesystem (unmount)))
(allow chdroidd fusectlfs (filesystem (remount)))
(allow chdroidd hwservicemanager (file (read)))
(allow chdroidd init (file (read)))
(allow chdroidd kernel (file (read)))
(allow chdroidd kernel (key (link)))
(allow chdroidd kernel (process (setsched)))
(allow chdroidd kernel (system (syslog_mod)))
(allow chdroidd keystore (file (read)))
(allow chdroidd labeledfs (filesystem (mount unmount)))
(allow chdroidd lmkd (file (read)))
(allow chdroidd logd (file (read)))
(allow chdroidd loop_control_device (chr_file (ioctl open read write)))
(allow chdroidd loop_device (blk_file (read write)))
(allow chdroidd net_data_file (dir (search)))
(allow chdroidd net_data_file (file (getattr open read)))
(allow chdroidd netd (file (read)))
(allow chdroidd node (icmp_socket (node_bind)))
(allow chdroidd node (tcp_socket (node_bind)))
(allow chdroidd node (udp_socket (node_bind)))
(allow chdroidd port (tcp_socket (name_bind name_connect)))
(allow chdroidd prng_seeder (file (read)))
(allow chdroidd proc (dir (mounton)))
