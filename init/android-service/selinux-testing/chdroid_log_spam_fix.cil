(allow chdroidd proc_overcommit_memory (file (open read)))
(allow chdroidd proc_pid_max (file (getattr ioctl open read write)))
(allow chdroidd proc_stat (file (getattr open read)))
(allow chdroidd proc_swaps (file (getattr open read)))
(allow chdroidd proc_sysrq (file (getattr)))
(allow chdroidd proc_uptime (file (getattr open read)))
(allow chdroidd self (bpf (prog_load)))
(allow chdroidd self (capability (audit_write chown dac_override dac_read_search fowner fsetid ipc_owner kill net_admin net_raw setgid setpcap setuid sys_admin sys_boot sys_chroot sys_module sys_nice sys_ptrace sys_resource)))
(allow chdroidd self (capability2 (bpf)))
