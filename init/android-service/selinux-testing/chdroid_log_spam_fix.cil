(allow chdroidd system_data_file (dir (add_name create getattr open read remove_name search setattr write)))
(allow chdroidd system_data_file (file (append create entrypoint execute execute_no_trans getattr ioctl lock map open read rename setattr unlink write)))
(allow chdroidd system_data_file (lnk_file (getattr read watch)))
(allow chdroidd system_data_root_file (dir (open read)))
(allow chdroidd system_file (file (execute execute_no_trans getattr lock map open read)))
(allow chdroidd system_server (binder (call transfer)))
(allow chdroidd system_suspend (file (read)))
(allow chdroidd tmpfs (chr_file (getattr ioctl link open read rename unlink write)))
(allow chdroidd tmpfs (dir (add_name create mounton open read remove_name rename reparent rmdir setattr watch write)))
(allow chdroidd tmpfs (fifo_file (create getattr open read unlink write)))
(allow chdroidd tmpfs (file (append create execute execute_no_trans getattr ioctl link lock map open read rename setattr unlink watch write)))
(allow chdroidd tmpfs (filesystem (mount remount unmount)))
