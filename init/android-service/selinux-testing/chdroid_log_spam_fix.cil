(allow chdroidd self (netlink_route_socket (bind create getattr getopt nlmsg_read nlmsg_readpriv nlmsg_write read setopt write)))
(allow chdroidd self (netlink_xfrm_socket (bind create)))
(allow chdroidd self (packet_socket (bind create read write)))
(allow chdroidd self (process (execmem getattr getcap getsession setpgid setrlimit setsched sigkill)))
(allow chdroidd self (rawip_socket (create getopt setopt write)))
(allow chdroidd self (shm (associate create getattr read unix_read unix_write write)))
(allow chdroidd self (tcp_socket (accept bind connect create getattr getopt listen read setopt shutdown write)))
(allow chdroidd self (udp_socket (bind connect create getattr ioctl read setopt write)))
(allow chdroidd self (unix_dgram_socket (bind connect getattr ioctl)))
(allow chdroidd self (unix_stream_socket (accept bind connectto create getattr ioctl listen setattr setopt shutdown)))
(allow chdroidd selinuxfs (file (open read)))
(allow chdroidd servicemanager (binder (call)))
(allow chdroidd servicemanager (file (read)))
(allow chdroidd servicemanager_prop (file (open read)))
(allow chdroidd statsd (file (read)))
(allow chdroidd su (file (read)))
(allow chdroidd sysfs (dir (open read)))
(allow chdroidd sysfs (file (getattr open read write)))
(allow chdroidd sysfs (filesystem (remount)))
(allow chdroidd sysfs_battery (dir (search)))
(allow chdroidd sysfs_battery (file (getattr open read)))
(allow chdroidd sysfs_batteryinfo (dir (search)))
