(allow chdroidd vold_data_file (file (append execute execute_no_trans getattr ioctl map open read relabelfrom relabelto unlink write)))

; init
(allow init chdroidd (process (noatsecure rlimitinh siginh transition)))
(allow init chdroidd (process2 (nosuid_transition)))
(allow init chdroidd_exec (file (execute getattr open read)))
(allow init chdroidd_exec (lnk_file (getattr read)))
(allow init system_data_file (file (execute getattr map open read)))

; kernel
(allow kernel device (blk_file (create getattr setattr unlink)))
(allow kernel device (chr_file (create setattr)))
(allow kernel chdroidd (fd (use)))
(allow kernel system_data_file (file (getattr open read write)))
(allow kernel vold_data_file (file (getattr open read write)))

; netd
(allow netd proc_net (dir (add_name)))
(allow netd proc_net (file (create)))

; servicemanager
(allow servicemanager chdroidd (binder (call transfer)))
(allow servicemanager chdroidd (dir (search)))
(allow servicemanager chdroidd (file (getattr open read)))
(allow servicemanager chdroidd (process (getattr)))

; system_server
(allow system_server chdroidd (binder (call transfer)))
(allow system_server chdroidd (fd (use)))
(allow system_server chdroidd (fifo_file (write)))
